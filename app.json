{
  "expo": {
    "name": "GymTrackr",
    "slug": "gymtrackr",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "gymtrackr",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#16191d",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.charkurylab.gymtrackr",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.charkurylab.gymtrackr",
      "softwareKeyboardLayoutMode": "pan",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#16191d"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "backgroundColor": "#16191d",
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120,
          "resizeMode": "contain",
          "backgroundColor": "#16191d"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6b9b426f-a0d5-4a49-9988-7f9c976e59cc"
      }
    },
    "icon": "./assets/images/icon.png",
    "owner": "rsutardji"
  }
}
